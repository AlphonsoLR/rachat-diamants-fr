    max-width: var(--mesure);
    margin: 1.6rem 0;
  }
  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--noir-surface);
    border: 1px solid var(--filet);
    flex: none;
  }
  .name {
    margin: 0 0 0.2rem;
    font-family: var(--font-heading);
    color: var(--eclat);
    font-size: 0.95rem;
  }
  .bio {
    margin: 0;
    font-size: 0.78rem;
    color: var(--gris-sourd);
    max-width: none;
