---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GeoBar from '../../components/GeoBar.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const pageUrl = `https://rachat-diamants.fr/guides/${guide.id}/`;
const formattedDate = guide.data.pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={guide.data.title} description={guide.data.description}>
  <article>
    <div class="wrap article-head">
      <nav class="breadcrumb"><a href="/">Accueil</a> › <a href="/guides/">Guides</a></nav>
      <h1>{guide.data.title}</h1>
      <time datetime={guide.data.pubDate.toISOString()}>{formattedDate}</time>
      <GeoBar pageUrl={pageUrl} />
    </div>

    {guide.data.heroImage && (
      <div class="hero-image wrap">
        <Image src={guide.data.heroImage} alt={guide.data.heroImageAlt ?? ''} width={1000} height={520} loading="eager" />
      </div>
    )}

    <div class="wrap prose">
      <Content />
      <AuthorBox />
    </div>
  </article>
</BaseLayout>

<style>
  .article-head {
    padding-top: 2.5rem;
  }
  .breadcrumb {
    font-size: 0.78rem;
    color: var(--gris-sourd);
    margin-bottom: 1.2rem;
  }
  .breadcrumb a {
    color: var(--gris-sourd);
    border-bottom: none;
  }
  .article-head h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0 0 0.6rem;
    max-width: 40ch;
  }
  .article-head time {
    color: var(--gris-sourd);
    font-size: 0.85rem;
  }
  .hero-image {
    margin: 1.6rem auto 0;
  }
  .hero-image :global(img) {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 14px;
  }
  .prose {
    max-width: 720px;
    margin: 2rem auto 4rem;
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .prose :global(h2) {
    margin-top: 2.2rem;
    font-size: 1.35rem;
  }
  .prose :global(a) {
    text-decoration: underline;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--filet);
    padding: 8px 10px;
    text-align: left;
    font-size: 0.92rem;
  }
</style>
