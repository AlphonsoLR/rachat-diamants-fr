---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import colors from '../../../../data/colors.json';
---

<BaseLayout title="Couleurs de diamants : échelle et prix" description="L'échelle de couleur des diamants (D à K, plus les fancy) et son impact sur le prix.">
  <div class="wrap page-head">
    <h1>Couleurs de diamants</h1>
    <p class="chapo">De D (incolore) à K (légèrement teinté), plus les couleurs fantaisie (fancy).</p>
  </div>
  <section>
    <div class="wrap">
      <div class="grid">
        {colors.map((c) => (
          <a class="color-link" href={`/diamant/couleur/${c.slug}/`}>{c.label}</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding-top: 2.5rem; }
  .chapo { max-width: 60ch; }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--filet);
    border: 1px solid var(--filet);
  }
  .color-link {
    display: block;
    text-align: center;
    background: var(--noir-carbone);
    padding: 1rem 0.5rem;
    color: var(--platine);
    border-bottom: none;
    font-size: 0.85rem;
  }
  @media (max-width: 700px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
