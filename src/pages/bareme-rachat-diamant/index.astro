---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GeoBar from '../../components/GeoBar.astro';
import Calculator from '../../components/Calculator.astro';
import pricingMatrix from '../../../data/pricing-matrix.json';

const pageUrl = 'https://rachat-diamants.fr/bareme-rachat-diamant/';
---

<BaseLayout
  title="Barème de rachat de diamants — méthodologie et calculateur"
  description="Notre méthode de calcul du barème de rachat de diamants, coefficient par coefficient, avec calculateur d'estimation gratuit."
>
  <div class="wrap page-head">
    <h1>Le barème de rachat rachat-diamants.fr</h1>
    <p class="chapo">
      Le diamant n'a pas de cours public comme l'or. Plutôt que de nous appuyer sur une liste de
      prix propriétaire sous licence (type Rapaport), nous publions notre propre méthode de calcul,
      en toute transparence.
    </p>
    <GeoBar pageUrl={pageUrl} mdUrl={`${pageUrl}.md`} />
  </div>

  <section>
    <div class="wrap">
      <div class="note warn">
        <span class="label">Statut de cette page</span>
        <p>
          {pricingMatrix._disclaimer}
        </p>
      </div>

      <h2>Calculateur d'estimation</h2>
      <p>Ajustez les caractéristiques pour obtenir une fourchette indicative en temps réel.</p>
      <Calculator />

      <h2>Formule</h2>
      <pre><code>prix_retail_estime = base_ct(palier_carat)
                     × facteur_couleur × facteur_purete × facteur_taille
                     × facteur_forme × facteur_fluorescence × facteur_certificat
                     × facteur_origine (naturel/synthèse)
                     × carat

prix_rachat_bas    = prix_retail_estime × {pricingMatrix.taux_rachat_bas}
prix_rachat_haut   = prix_retail_estime × {pricingMatrix.taux_rachat_haut}</code></pre>

      <p class="disclaimer-inline">Dernière révision affichée : {pricingMatrix.last_review}.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding-top: 2.5rem; }
  .chapo { max-width: 60ch; }
  pre {
    font-size: 0.82rem;
    background: var(--noir-carbone);
    border: 1px solid var(--filet);
    border-left: 2px solid var(--accent);
    padding: 1.2rem 1.4rem;
    overflow-x: auto;
    color: var(--platine);
  }
  .disclaimer-inline {
    font-size: 0.78rem;
    color: var(--gris-sourd);
  }
</style>
