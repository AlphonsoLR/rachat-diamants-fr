---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DiamondShapeIcon from '../../../components/DiamondShapeIcon.astro';
import PriceTable from '../../../components/PriceTable.astro';
import ProductCard from '../../../components/ProductCard.astro';
import GeoBar from '../../../components/GeoBar.astro';
import { Image } from 'astro:assets';
import ambianceImage from '../../../assets/images/pexels-2799863.jpg';
import shapes from '../../../../data/shapes.json';
import carats from '../../../../data/carats.json';
import cities from '../../../../data/cities.json';
import { estimate, formatRange } from '../../../lib/pricing';

export function getStaticPaths() {
  return shapes.map((shape) => ({ params: { forme: shape.slug }, props: { shape } }));
}

const { shape } = Astro.props;
const pageUrl = `https://rachat-diamants.fr/diamant/forme/${shape.slug}/`;

const priceRows = carats
  .filter((c) => [0.5, 1.0, 1.5, 2.0, 3.0].includes(c.value))
  .map((c) => {
    const est = estimate({ carat: c.value, shapeSlug: shape.slug, colorSlug: 'g', claritySlug: 'vs1' });
    return {
      carat: c.label,
      retail: formatRange(est.retail),
      rachat: formatRange(est.rachat),
      delai: '48 h',
    };
  });

const otherShapes = shapes.filter((s) => s.slug !== shape.slug);
const topCities = [...cities].filter((c) => c.tier === 1).slice(0, 12);
---

<BaseLayout
  title={`Diamant taille ${shape.name} : prix, rachat et estimation`}
  description={`Fourchette de prix et de rachat pour un diamant taille ${shape.name}, ratio idéal ${shape.ratio_ideal}, ${shape.facets} facettes.`}
>
  <div class="wrap page-head">
    <nav class="breadcrumb"><a href="/">Accueil</a> › <a href="/diamant/forme/">Formes</a> › {shape.name}</nav>
    <div class="head-grid">
      <div class="icon-large"><DiamondShapeIcon shape={shape.slug} size={140} /></div>
      <div>
        <h1>Diamant taille {shape.name} : prix, rachat et estimation</h1>
        <p class="chapo">{shape.description_long}</p>
        <ul class="specs">
          <li><span>Ratio idéal</span> {shape.ratio_ideal}</li>
          <li><span>Facettes</span> {shape.facets}</li>
          <li><span>Popularité</span> #{shape.popularity_rank} des formes les plus vendues</li>
        </ul>
      </div>
    </div>
    <GeoBar pageUrl={pageUrl} mdUrl={`${pageUrl}.md`} />
  </div>

  <div class="wrap">
    <Image src={ambianceImage} alt={`Diamant, ambiance ${shape.name}`} width={1100} height={480} loading="lazy" class="ambiance-banner" />
  </div>

  <section>
    <div class="wrap">
      <h2>Prix et rachat par carat — taille {shape.name}</h2>
      <p>Fourchettes en qualité de référence G / VS1 / taille Excellent.</p>
      <PriceTable rows={priceRows} />
      <p class="disclaimer-inline">
        Fourchettes indicatives calculées à partir d'un barème d'exemple non encore validé par un
        expert métier — à ne pas utiliser en production.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Impact de la forme sur la revente</h2>
      <p>
        Le facteur de prix relatif de cette taille, par rapport au rond brillant (référence = 1.0),
        est de <strong>{shape.price_factor}</strong>. Les tailles à facettage brillant (rond,
        princesse, coussin) conservent généralement une meilleure liquidité de revente que les
        tailles étagées (émeraude, asscher), plus sensibles à la pureté visible.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Meilleures villes pour vendre un diamant {shape.name}</h2>
      <div class="grid grid-4">
        {topCities.map((c) => (
          <a class="city-link" href={`/rachat-diamant/${c.slug}/`}>{c.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Les autres formes</h2>
      <div class="grid grid-5">
        {otherShapes.map((s) => (
          <ProductCard href={`/diamant/forme/${s.slug}/`} title={s.name} shape={s.slug} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: 2.5rem;
  }
  .breadcrumb {
    font-size: 0.78rem;
    color: var(--gris-sourd);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    color: var(--gris-sourd);
    border-bottom: none;
  }
  .head-grid {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    align-items: start;
  }
  .icon-large {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    border: 1px solid var(--filet);
    background: var(--noir-carbone);
  }
  :global(.ambiance-banner) {
    width: 100%;
    aspect-ratio: 21 / 8;
    object-fit: cover;
    border-radius: 18px;
    margin: 2rem 0;
  }
  .chapo {
    font-size: 1.02rem;
  }
  .specs {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: flex;
    gap: 1.6rem;
    flex-wrap: wrap;
  }
  .specs li {
    font-size: 0.85rem;
    color: var(--eclat);
  }
  .specs span {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gris-sourd);
    margin-bottom: 0.2rem;
  }
  .disclaimer-inline {
    font-size: 0.78rem;
    color: var(--gris-sourd);
    max-width: var(--mesure);
  }
  .grid {
    display: grid;
    gap: 1px;
    background: var(--filet);
    border: 1px solid var(--filet);
    margin-top: 1rem;
  }
  .grid-5 {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .grid-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .city-link {
    display: block;
    background: var(--noir-carbone);
    padding: 0.9rem 1rem;
    color: var(--platine);
    border-bottom: none;
    font-size: 0.85rem;
  }
  @media (max-width: 700px) {
    .head-grid { grid-template-columns: 1fr; }
    .grid-5 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
