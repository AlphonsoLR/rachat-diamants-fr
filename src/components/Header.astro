---
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo/logo-icon.png';

const navItems = [
  { label: 'Villes', href: '/rachat-diamant/' },
  { label: 'Barème', href: '/bareme-rachat-diamant/' },
  { label: 'Blog', href: '/guides/' },
  { label: 'Estimation', href: '/estimation/' },
];
---

<header>
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <Image src={logoIcon} alt="" class="mark" width={36} height={30} />
      rachat-diamants<span class="tld">.fr</span>
    </a>
    <nav>
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn cta" href="/estimation/">Estimer mon diamant</a>
  </div>
</header>

<style>
  header {
    position: relative;
    z-index: 100;
    border-bottom: 1px solid var(--filet);
    background: var(--noir-profond);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--eclat);
    border-bottom: none;
    white-space: nowrap;
  }
  .brand :global(.mark) {
    width: 34px;
    height: auto;
    flex: none;
  }
  .brand .tld {
    color: var(--gris-sourd);
  }
  nav {
    flex: 1;
  }
  nav ul {
    display: flex;
    gap: 1.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 0.88rem;
    color: var(--platine);
    border-bottom: none;
  }
  nav a:hover {
    color: var(--eclat);
  }
  .cta {
    font-size: 0.82rem;
    padding: 0.65rem 1.2rem;
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
  }
</style>
