---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Estimation gratuite de votre diamant"
  description="Formulaire d'estimation gratuite et sans engagement pour votre diamant."
>
  <div class="wrap page-head">
    <h1>Estimation gratuite</h1>
    <p class="chapo">
      Formulaire en 4 étapes à construire (lot L7 du brief) : objet possédé, caractéristiques
      connues, certificat, coordonnées. Anti-spam honeypot + Cloudflare Turnstile, sans reCAPTCHA.
    </p>
    <div class="note">
      <span class="label">À faire</span>
      <p>Formulaire non encore implémenté — placeholder de structure uniquement.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-head { padding-top: 2.5rem; }
  .chapo { max-width: 60ch; }
</style>
