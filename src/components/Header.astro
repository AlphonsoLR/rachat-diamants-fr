---
import { Image } from 'astro:assets';
import logoFull from '../assets/logo/logo-full.png';

const navItems = [
  { label: 'Villes', href: '/rachat-diamant/' },
  { label: 'Barème', href: '/bareme-rachat-diamant/' },
  { label: 'Blog', href: '/guides/' },
  { label: 'Estimation', href: '/estimation/' },
];
---

<header>
  <div class="wrap header-inner">
    <a href="/" class="brand">
      <Image src={logoFull} alt="rachat-diamants.fr" class="logo-full" width={241} height={136} />
    </a>
    <nav class="desktop-nav">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn cta" href="/estimation/">Estimer mon diamant</a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Ouvrir le menu">
      <span></span><span></span><span></span>
    </label>
    <nav class="mobile-nav" aria-label="Menu mobile">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/estimation/" class="mobile-cta">Estimer mon diamant</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    position: relative;
    z-index: 100;
    border-bottom: 1px solid var(--filet);
    background: var(--noir-profond);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    position: relative;
  }
  .brand {
    display: flex;
    align-items: center;
    border-bottom: none;
  }
  .brand :global(.logo-full) {
    height: 52px;
    width: auto;
    flex: none;
  }
  .desktop-nav {
    flex: 1;
  }
  .desktop-nav ul {
    display: flex;
    gap: 1.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop-nav a {
    font-size: 0.88rem;
    color: var(--platine);
    border-bottom: none;
  }
  .desktop-nav a:hover {
    color: var(--eclat);
  }
  .cta {
    font-size: 0.82rem;
    padding: 0.65rem 1.2rem;
    white-space: nowrap;
  }

  .nav-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .nav-toggle-label {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    align-items: center;
    cursor: pointer;
    flex: none;
  }
  .nav-toggle-label span {
    width: 22px;
    height: 2px;
    background: var(--eclat);
    border-radius: 2px;
    transition: transform 0.2s ease-out, opacity 0.2s ease-out;
  }
  .mobile-nav {
    display: none;
  }

  @media (max-width: 720px) {
    .header-inner {
      gap: 1rem;
    }
    .desktop-nav,
    .cta {
      display: none;
    }
    .nav-toggle-label {
      display: flex;
      margin-left: auto;
    }
    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
    .mobile-nav {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--noir-profond);
      border-bottom: 1px solid var(--filet);
      box-shadow: 0 12px 24px rgba(13, 29, 58, 0.12);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease-out;
    }
    .nav-toggle:checked ~ .mobile-nav {
      max-height: 400px;
    }
    .mobile-nav ul {
      list-style: none;
      margin: 0;
      padding: 0.5rem 1.25rem 1.25rem;
      display: flex;
      flex-direction: column;
    }
    .mobile-nav li {
      border-bottom: 1px solid var(--filet);
    }
    .mobile-nav li:last-child {
      border-bottom: none;
      padding-top: 0.8rem;
    }
    .mobile-nav a {
      display: block;
      padding: 0.9rem 0.2rem;
      font-size: 0.95rem;
      color: var(--platine);
      border-bottom: none;
    }
    .mobile-nav .mobile-cta {
      display: inline-flex;
      background: var(--gradient-sparkle);
      color: var(--eclat);
      border-radius: 999px;
      padding: 0.7rem 1.4rem;
      font-weight: 600;
    }
  }
</style>
