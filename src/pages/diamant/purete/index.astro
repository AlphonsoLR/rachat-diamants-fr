---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import clarity from '../../../../data/clarity.json';
---

<BaseLayout title="Pureté des diamants : échelle et prix" description="L'échelle de pureté des diamants (IF à SI2) et son impact sur le prix.">
  <div class="wrap page-head">
    <h1>Pureté des diamants</h1>
    <p class="chapo">De IF (Internally Flawless) à SI2, l'échelle de pureté GIA.</p>
  </div>
  <section>
    <div class="wrap">
      <div class="grid">
        {clarity.map((c) => (
          <a class="clarity-link" href={`/diamant/purete/${c.slug}/`}>{c.grade}</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding-top: 2.5rem; }
  .chapo { max-width: 60ch; }
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    background: var(--filet);
    border: 1px solid var(--filet);
  }
  .clarity-link {
    display: block;
    text-align: center;
    background: var(--noir-carbone);
    padding: 1rem 0.5rem;
    color: var(--platine);
    border-bottom: none;
    font-size: 0.9rem;
  }
  @media (max-width: 700px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
