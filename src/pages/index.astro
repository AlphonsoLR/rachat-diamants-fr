---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { Image } from 'astro:assets';
import shapes from '../../data/shapes.json';
import cities from '../../data/cities.json';
import heroImage from '../assets/images/pexels-3091638.jpg';
import syntheseImage from '../assets/images/pexels-2735981.jpg';

const t1Cities = cities.filter((c) => c.tier === 1).slice(0, 12);
---

<BaseLayout
  title="Rachat de diamants en France"
  description="Barème de rachat transparent, estimation gratuite et guides pour vendre ou acheter un diamant partout en France."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow"><span class="mark"></span> Barème indicatif · révisé juillet 2026</p>
        <h1>Le premier barème de rachat <em>transparent</em> pour vos diamants</h1>
        <p class="dek">
          Contrairement à l'or, le diamant n'a pas de cours public. Nous publions notre méthode de
          calcul, fourchette par fourchette, ville par ville — sans promesse de prix ferme avant
          examen physique.
        </p>
        <div class="cta-row">
          <a class="btn" href="/estimation/">Estimer mon diamant</a>
          <a class="btn btn-ghost" href="/bareme-rachat-diamant/">Voir le barème</a>
        </div>
      </div>
      <div class="hero-visual">
        <Image src={heroImage} alt="Bague sertie d'un diamant, gros plan macro" width={640} height={800} loading="eager" />
      </div>
    </div>
  </section>

  <section class="shapes">
    <div class="wrap">
      <h2>Formes de diamants</h2>
      <p>Chaque forme influence différemment la valeur de rachat.</p>
      <div class="grid grid-5">
        {shapes.map((s) => (
          <ProductCard href={`/diamant/forme/${s.slug}/`} title={s.name} subtitle={s.ratio_ideal} shape={s.slug} />
        ))}
      </div>
    </div>
  </section>

  <section class="villes">
    <div class="wrap">
      <h2>Rachat de diamants par ville</h2>
      <p>Estimation et vente partout en France — voici les principales métropoles couvertes.</p>
      <div class="grid grid-4">
        {t1Cities.map((c) => (
          <a class="city-link" href={`/rachat-diamant/${c.slug}/`}>{c.name} <span>({c.department.code})</span></a>
        ))}
      </div>
      <a class="see-all" href="/rachat-diamant/">Voir toutes les villes →</a>
    </div>
  </section>

  <section class="synthese">
    <div class="wrap synthese-grid">
      <Image src={syntheseImage} alt="Gros plan sur une bague en diamant" width={520} height={640} loading="lazy" />
      <div>
        <h2>Naturel ou synthèse ?</h2>
        <p class="dek">
          Un diamant de synthèse (laboratoire) n'a pas la même valeur de revente qu'un diamant
          naturel — un écart que nous assumons de dire clairement, plutôt que de le maquiller.
        </p>
        <a class="btn btn-ghost" href="/diamant-synthese-lab-grown/">Comprendre la différence →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero-visual :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: 0 30px 60px -20px rgba(20, 22, 60, 0.25);
  }
  .synthese-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  .synthese-grid :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 20px;
  }
  @media (max-width: 800px) {
    .hero-grid,
    .synthese-grid {
      grid-template-columns: 1fr;
    }
    .synthese-grid {
      direction: ltr;
    }
  }
  .dek {
    color: var(--gris-fume);
    max-width: 58ch;
    font-size: clamp(1rem, 2vw, 1.15rem);
    margin: 1.5rem 0 2rem;
  }
  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .grid {
    display: grid;
    gap: 1px;
    background: var(--filet);
    border: 1px solid var(--filet);
    margin-top: 1.6rem;
  }
  .grid-5 {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .grid-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .city-link {
    display: block;
    background: var(--noir-carbone);
    padding: 1rem 1.2rem;
    color: var(--platine);
    border-bottom: none;
    font-size: 0.9rem;
  }
  .city-link:hover {
    color: var(--eclat);
  }
  .city-link span {
    color: var(--gris-sourd);
    font-size: 0.78rem;
  }
  .see-all {
    display: inline-block;
    margin-top: 1.4rem;
    font-size: 0.85rem;
  }
  @media (max-width: 900px) {
    .grid-5 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
